// Android API27配置示例；部署说明见android/README.md。
general = {
  name = "LX04 AirPlay2";
  service_type = "airplay2";
  output_backend = "aaudio";
  mdns_backend = "dns-sd";
  // 回退到 SPS 调音时，缩小软件衰减范围，让低百分比更容易听见。
  // volume_max_db = -2.0; // 系统音量同步启用时的默认值，可显式覆盖。
  volume_control_profile = "flat";
  volume_range_db = 30;
  // 配合12000帧共享缓冲，增加网络播放队列余量。
  audio_backend_buffer_desired_length_in_seconds = 0.35;
};

// 与程序缺省值一致；可省略整个diagnostics组。
diagnostics = {
  log_verbosity = 1;
  statistics = "yes";
  log_show_time_since_startup = "no";
  log_show_time_since_last_message = "no";
  log_show_file_and_line = "yes";
};

// Companion App 可选桥接；先安装 APK 并查出其 UID，再启用并重启 SPS。
// android_companion = {
//   enabled = true;
//   allowed_uid = 10000; // 必须替换为本机 org.shairport.sync.android 的实际 UID。
// };

android = {
  sync_system_volume = true; // 默认启用；同步还需要上方的 Companion 桥接。
};
